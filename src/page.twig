{% extends 'markup/single/layout.twig' %}

{% block page %}
<main class="sb-internal-main movable mt-[75px] flex basis-[720px] flex-col max-[640px]:w-full">
    <article class="{{ article.classes }} flex flex-col items-center text-justify" id="post-{{ article.id }}">
        <h1 class="entry-title w-[85%] max-w-[780px] text-left">{{ article.title }}</h1>
        <div class="entry-content w-[85%] max-w-[780px]">
            {{ content.html }}
            {{ content.page_links }}
            {% if show_tags %}{{ content.tags }}{% endif %}
        </div>
    </article>
    {% if show_navigation %}
        <div class="navigation">
            <div class="next-posts">{{ navigation.next }}</div>
            <div class="prev-posts">{{ navigation.previous }}</div>
        </div>
    {% endif %}
</main>
{% endblock %}
