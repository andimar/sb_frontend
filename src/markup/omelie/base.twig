<section id="omelie" class="sb-section sb-homilies-section" aria-labelledby="homilies-title">
    {% include '/markup/common/section-title.twig' with { section_title: 'OMELIE', section_title_id: 'homilies-title', section_title_class: 'sb-section-title--light' } %}
        
    <div id="omelie-content" class="sb-homilies-content sb-section-content">

        <div id="omelie-content-image" aria-hidden="true"></div>
        <div id="omelie-content-card">
            {% include '/markup/omelie/card.twig' %}
        </div>
        <form id="omelie-content-search" action="/" role="search" method="get">
            <label class="sr-only" for="homily-search">Cerca tra le omelie</label>
            <input type="search" id="homily-search" name="s" placeholder="Cerca tra le omelie">
            <button type="submit">cerca</button>
        </form>    
    </div>
    
</section>

<style>
#omelie-content-image { background-image: url({{base_dir}}/assets/don-fabio-pieroni.png); }
</style>
