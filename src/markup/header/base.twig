<header class="sb-home-header">
    {% include '/markup/header/components/topbar.twig' %}

    <div id="header-container" class="sb-hero-grid">
        <div class="sb-home-info-column">{% include '/markup/header/components/home-info-box.twig' %}</div>

        <div class="sb-hero-news-list">
            {% for item in news_top %}
            <div class="sb-hero-news-item">
                {% include '/markup/news/news_card.twig' %}
            </div>
            {% endfor %}
        </div>
    </div>

</header>
<style>
    header { background-image: url('{{base_dir}}/assets/s-bernardo.jpg'); }
</style>

