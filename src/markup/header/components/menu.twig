<nav id="menu_desktop" role="navigation">
    <ul class="first-level">
        {% for item in menu %}
            {% if item.subitems %}

                <li aria-haspopup="true">
            
                    <a href="{{ item.link }}">{{ item.label }}</a>
                    
                    <ul class="dropdown" aria-label="submenu">
                        {% for subitem in item.subitems %}
                        <li><a href="{{ subitem.link }}">{{ subitem.label }}</a></li>
                        {% endfor %}    
                    </ul>
                </li>

            {% else %}

                <li><a href="{{ item.link }}">{{ item.label }}</a></li>

            {% endif %}            
        {% endfor %}
        <li class="menu-youtube"><a href="https://www.youtube.com/channel/UCElYF70vRihTWXdWaabuwMA" target="_blank" rel="noopener noreferrer" aria-label="Canale YouTube della parrocchia"><svg viewBox="0 0 24 18" width="24" height="18" aria-hidden="true"><path fill="currentColor" d="M23.5 3a3 3 0 0 0-2.1-2.1C19.5.4 12 .4 12 .4S4.5.4 2.6.9A3 3 0 0 0 .5 3C0 4.9 0 9 0 9s0 4.1.5 6a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-6 .5-6s0-4.1-.5-6Z"/><path fill="#242424" d="m9.5 12.7 6-3.7-6-3.7Z"/></svg></a></li>
    </ul>
</nav>
