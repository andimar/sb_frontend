<div id="home-info-box">

    <div id="logo"><img src="{{base_dir}}/assets/logo.svg" alt="Parrocchia San Bernardo da Chiaravalle"></div>

    <div id="info-messe" class="info-box">
        <div class="info-box-icon"><img src="{{base_dir}}/assets/eucharist.svg" alt=""></div>
        <div class="info-box-content">
            <h3>{{ hours.masses.label }}</h3>
            <p>{{ hours.masses.festivo }}</p>
            <h4>FERIALE</h4>
            <p>{{ hours.masses.feriale }}</p>
        </div>
    </div>

    <div id="info-ufficio" class="info-box">
        <div class="info-box-icon"><img src="{{base_dir}}/assets/rubber-stamp.svg" alt=""></div>
        <div class="info-box-content">
            <h3 class="info-box-content-title">UFFICIO PARROCCHIALE</h3>
            <p class="info-box-content-text">{{ hours.office }}</p>
        </div>
    </div>

</div>
