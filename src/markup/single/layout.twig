<!doctype html>
<html class="no-js" {{ document.language_attributes }}>
<head>
    <meta charset="{{ document.charset }}">
    <title>{{ document.title }}</title>
    <meta name="Copyright" content="Copyright © {{ document.name }} {{ document.year }}. All Rights Reserved.">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    {% if document.logo.favicon_svg %}<link rel="icon" type="image/svg+xml" href="{{ document.logo.favicon_svg }}">{% endif %}
    <link rel="icon" type="image/x-icon" href="{{ document.logo.favicon_ico }}">
    <link rel="profile" href="https://gmpg.org/xfn/11">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    {% if document.external_services %}
    <script data-ad-client="ca-pub-4486592461412993" async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js"></script>
    {% endif %}
    {{ wp_head }}
</head>
<body class="sb-internal-body sb-logo-{{ document.logo.variant }} {{ document.body_classes }}">
    {{ wp_body_open }}
    <aside id="off-canvas-menu" class="sb-internal-menu movable">
        <div id="hamburger--icon">
            <a href="#">
                <svg width="100%" height="100%" viewBox="0 0 100 100">
                    <rect id="line-1" x="10" y="20" width="80" height="15"/>
                    <rect id="line-2" x="10" y="50" width="80" height="15"/>
                    <rect id="line-3" x="10" y="80" width="80" height="15"/>
                </svg>
            </a>
        </div>
        <a class="sb-menu-youtube-link" href="https://www.youtube.com/channel/UCElYF70vRihTWXdWaabuwMA" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span> Canale YouTube</a>
        {{ primary_menu }}
    </aside>
    <div id="container" class="sb-internal-container">
        <header class="topbar header sb-internal-header movable">
            <a class="logo" href="{{ document.home_url }}" title="{{ document.name }}" rel="home" style="--sb-logo-compact: url('{{ document.logo.compact }}'); --sb-logo-extended: url('{{ document.logo.extended }}');">{{ document.name }}</a>
        </header>
        {% block page %}{% endblock %}
        {# No legacy dynamic_sidebar: site components replace widgets. #}
        <footer id="footer" class="sb-internal-footer movable source-org vcard copyright" role="contentinfo">
            <a class="footer-logo" href="{{ document.home_url }}" rel="home">
                <img src="{{ document.logo.footer }}" width="158" height="57" alt="{{ document.name }}">
            </a>
            <a class="sb-footer-youtube-link" href="https://www.youtube.com/channel/UCElYF70vRihTWXdWaabuwMA" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">▶</span> Canale YouTube</a>
            <small class="footer-colophon">©{{ document.year }} {{ document.name }}</small>
        </footer>
    </div>
    {% if document.external_services %}
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-3452513-9"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'UA-3452513-9');
    </script>
    {% endif %}
    {{ wp_footer }}
</body>
</html>
