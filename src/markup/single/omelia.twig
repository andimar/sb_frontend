{% extends 'markup/single/article.twig' %}

{% block date %}<span class="pubdate">{% if gospel.date %}{{ gospel.date }}{% else %}Data dell’omelia da verificare{% endif %}</span>{% endblock %}

{% block archive_navigation %}
    {% if archive_url %}
    <nav class="sb-omelia-archive-link" aria-label="Archivio omelie">
        <a href="{{ archive_url }}"><span aria-hidden="true">←</span> Tutte le omelie</a>
    </nav>
    {% endif %}
{% endblock %}

{% block calendar %}
    {% if gospel %}<span class="calendario">{{ gospel.calendar }}</span>{% endif %}
{% endblock %}

{% block before_content %}
    {% if gospel %}
    <div class="vangelo">
        <h4>{{ gospel.reference }}</h4>
        {{ gospel.text }}
    </div>
    {% endif %}
{% endblock %}
