<article class="{{ article.classes }} flex flex-col items-center text-justify" id="post-{{ article.id }}">
    <div class="categorybar">
        {% if categories %}
            <ul class="post-categories">
                {% for category in categories %}
                    <li class="{{ category.classes }}">
                        <a href="{{ category.url }}" rel="{{ category.rel }}">{{ category.label }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
    <h1 class="entry-title w-[85%] max-w-[780px] text-left">{{ article.title }}</h1>
    <div class="authorbar">
        <span class="pubdate">{{ article.date }}</span>
        {% block calendar %}{% endblock %}
        di <span class="author">{{ author }}</span>
    </div>
    <div class="entry-content w-[85%] max-w-[780px]">
        {% block before_content %}{% endblock %}
        {{ content.html }}
        {{ content.page_links }}
        {{ content.tags }}
    </div>
</article>
