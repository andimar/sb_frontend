{% extends 'markup/single/layout.twig' %}

{% block page %}
<main class="movable">
    {% block article %}{% include 'markup/single/article.twig' %}{% endblock %}
    <div class="navigation">
        <div class="next-posts">{{ navigation.next }}</div>
        <div class="prev-posts">{{ navigation.previous }}</div>
    </div>
</main>
{% endblock %}
