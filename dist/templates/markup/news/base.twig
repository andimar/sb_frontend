<section id="news" class="sb-section sb-news-section {{ (news|length == 0) ? 'hidden':'' }}" aria-labelledby="news-title">
    {% include '/markup/common/section-title.twig' with { section_title: 'NOTIZIE', section_title_id: 'news-title', section_title_class: 'sb-section-title--red' } %}

    <div id="news-carousel" class="swiper sb-section-content">
        
        <div class="swiper-wrapper">
            {% for item in news %}
                <div class="swiper-slide sb-news-slide">
                    {% include '/markup/news/news_card.twig' %}
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="sb-news-controls">
        <div class="swiper-pagination" aria-label="Paginazione delle notizie"></div>
    </div>
</section>

{% block scripts %}
<script src="{{base_dir}}/scripts/NewsArranger.js?v={{ asset_version }}"></script>

<script>
    function activateCarousel() {

        const swiper = new Swiper('.swiper', {

            // Default parameters
            slidesPerView: 3,
            spaceBetween: 8,
            
            // Responsive breakpoints
            breakpoints: {
                // when window width is >= 320px
                320: { slidesPerView: 1.28, spaceBetween: 10 } ,
                // when window width is >= 480px
                480: { slidesPerView: 1 },
                // when window width is >= 640px
                640: { slidesPerView: 2 },
                // when window width is >= 640px
                1024: { slidesPerView: 3 }
            },
            
            // If we need pagination
            pagination: {
                el: '#news .swiper-pagination',
                clickable: true
            },
        });
    }

    window.addEventListener('DOMContentLoaded', () => {
        const newsArranger = new NewsArranger(window.matchMedia('(max-width: 1024px)').matches);
    

        newsArranger.arrange(  function(){
         
            if(newsArranger.cards.length){ 
                document.getElementById('news').classList.remove('hidden');
                activateCarousel();
            } 

        }.bind(this ) );
        
        console.log('newsArranger',newsArranger);
    });


</script> 
{% endblock %}
