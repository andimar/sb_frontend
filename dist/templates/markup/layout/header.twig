        <link rel="icon" type="image/x-icon" href="{{ logo.favicon_ico }}">

        {#  SCRIPTS E STYLES CHE DOVRANNO DIVENTARE DINAMICI #}

        <link rel="stylesheet" href="{{base_dir}}/styles/lib/swiper-bundle.min.css?v={{ asset_version }}" type="text/css" >
