{% if pagination %}
<nav id="pagination" class="sb-pagination" aria-label="Paginazione delle omelie"><ul>
    {% for page in pagination %}<li>
        {% if page.current %}
            <span class="{{ page.class }}" aria-current="page" aria-label="{{ page.aria_label }}">{{ page.label }}</span>
        {% elseif page.disabled %}
            <span class="{{ page.class }}" aria-hidden="true">{{ page.label }}</span>
        {% else %}
            <a href="{{ page.url }}" class="{{ page.class }}" aria-label="{{ page.aria_label }}"{% if page.rel %} rel="{{ page.rel }}"{% endif %}>{{ page.label }}</a>
        {% endif %}
    </li>{% endfor %}
</ul></nav>
{% endif %}
