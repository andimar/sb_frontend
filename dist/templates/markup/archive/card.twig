<article class="homily-card {{ item.classes }}" id="post-{{ item.id }}">
    <a href="{{ item.url }}">
        <header class="homily-card-header">
            <span class="pubdate">{% if item.date %}{{ item.date }}{% else %}Data dell’omelia da verificare{% endif %}</span>
            {% if item.liturgical_calendar %}<span class="calendario">{{ item.liturgical_calendar }}</span>{% endif %}
            {% if item.gospel_reference %}
            <div class="homily-card-gospel"><span class="vangelo_rif">{{ item.gospel_reference }}</span></div>
            {% endif %}
            <h2 class="homily-card-title">{{ item.title }}</h2>
        </header>
        <blockquote class="homily-card-excerpt">
            <span class="homily-card-quote-mark" aria-hidden="true">“</span>
            {{ item.excerpt }}
        </blockquote>
        <span class="homily-card-action">Leggi l’omelia <span aria-hidden="true">→</span></span>
    </a>
</article>
